#. Plugin Name of the plugin
#: cookies-with-ease.php includes/class-post-type.php:19
#: includes/class-settings.php:72
msgid "Cookies with Ease"
msgstr "Cookies with Ease"

#. Description of the plugin
#: cookies-with-ease.php
msgid "A simple, privacy-friendly cookie consent manager based on Klaro!. Gate third-party scripts and embeds behind visitor consent, manage them as Applications, and style the banner with built-in color schemes."
msgstr "Een eenvoudige, privacyvriendelijke cookie-consentmanager op basis van Klaro!. Laad scripts en insluitingen van derden pas na toestemming van de bezoeker, beheer ze als Applicaties en pas de banner aan met ingebouwde kleurenschema's."

#. Author of the plugin
